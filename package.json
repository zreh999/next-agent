{
  "name": "next-agent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "本命回响 · Agent Resonance — psychology-inspired VALORANT playstyle exploration",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/check-static.mjs",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:compat": "vitest run --config vitest.compat.config.ts --configLoader native",
    "test:smoke": "node scripts/check-static.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
