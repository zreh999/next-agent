# Optional locally: without DATABASE_URL, development uses .data/store.json.
# PostgreSQL is recommended for deployed use.
# DATABASE_URL="postgresql://nextagent:nextagent@localhost:5432/nextagent?schema=public"

# Only allow file storage on a single instance with a persistent writable disk.
# ALLOW_FILE_STORAGE="true"
# Public HTTPS origin when deployed, for strict browser request validation.
# APP_ORIGIN="https://your-domain.example"
# Enable only when your reverse proxy overwrites forwarded addresses.
# TRUST_PROXY="true"
# Optional for development hosts that restrict child processes.
# NEXT_AGENT_WORKER_THREADS="true"
# Optional: set your repository URL for the site header/footer.
# NEXT_PUBLIC_GITHUB_URL="https://github.com/YOUR_ACCOUNT/next-agent"
